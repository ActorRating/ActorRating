generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// NextAuth / Auth.js user (magic-link email auth). Linked to ratings and performances via `userId`.
model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  onboardingCompleted Boolean @default(false)
  status        UserStatus @default(ACTIVE)
  onboardingStartedAt DateTime?
  /// Set when user agrees to Terms during signup / finish-account.
  termsAcceptedAt DateTime?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  source        String?   @db.VarChar(50)
  firstSeenAt   DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  performances  Performance[]
  ratings       Rating[]
  pageViews     PageView[]
  productEvents ProductEvent[]
  ratingCommentReports RatingCommentReport[] @relation("CommentReporter")
  resolvedCommentReports RatingCommentReport[] @relation("CommentReportResolver")
  forumThreads ForumThread[]
  forumPosts ForumPost[]
  forumPostReports ForumPostReport[] @relation("ForumPostReporter")
  resolvedForumPostReports ForumPostReport[] @relation("ForumPostReportResolver")
  ownedInvites InviteCode[] @relation("OwnedInvites")
  usedInvite   InviteCode?  @relation("UsedInvite")
  inviteRedemptions InviteRedemption[]

  @@index([createdAt])
  @@index([email])
  @@index([username])
}

/// First-party pageview log for admin analytics (human + bot-flagged).
/// Prune rows older than 90 days (see scripts/prune-pageviews.ts).
model PageView {
  id          String       @id @default(cuid())
  path        String
  referrer    String?
  utmSource   String?      @db.VarChar(100)
  utmMedium   String?      @db.VarChar(100)
  utmCampaign String?      @db.VarChar(200)
  userId      String?
  ipHash      String
  userAgent   String       @db.Text
  isLikelyBot Boolean      @default(false)
  /// Set only when isLikelyBot: disclosed crawler vs unidentified/spoofed.
  botCategory BotCategory?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([isLikelyBot, createdAt])
  @@index([botCategory, createdAt])
  @@index([path, createdAt])
  @@index([utmSource, createdAt])
  @@index([ipHash, createdAt])
}

/// First-party product events for admin funnels (performance_viewed, rating_submitted, etc.).
/// Prune rows older than 90 days alongside PageView.
model ProductEvent {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(80)
  path        String?
  actor       String?      @db.VarChar(200)
  movie       String?      @db.VarChar(200)
  source      String?      @db.VarChar(50)
  utmSource   String?      @db.VarChar(100)
  utmMedium   String?      @db.VarChar(100)
  utmCampaign String?      @db.VarChar(200)
  utmContent  String?      @db.VarChar(200)
  properties  Json?
  userId      String?
  ipHash      String
  userAgent   String       @db.Text
  isLikelyBot Boolean      @default(false)
  botCategory BotCategory?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([source, createdAt])
  @@index([utmSource, createdAt])
  @@index([isLikelyBot, createdAt])
  @@index([ipHash, createdAt])
  @@index([path, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimit {
  id          String   @id @default(cuid())
  ip          String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ip, action, windowStart])
  @@index([ip, action])
}

model Actor {
  id           String        @id @default(cuid())
  name         String        @unique
  bio          String?
  imageUrl     String?
  birthDate    DateTime?
  nationality  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  knownFor     String?
  tmdbId       Int?          @unique
  slug         String?       @unique
  performances Performance[]
  ratings      Rating[]
  forumThreads ForumThread[]
  editorials   PerformanceEditorial[]

  @@index([name])
  @@index([slug])
}

model Movie {
  id             String        @id @default(cuid())
  title          String
  year           Int
  director       String?
  genre          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  overview       String?
  tmdbId         Int?          @unique
  slug           String?       @unique
  /// Set when full cast ingestion last ran for this movie (cosmetic proof).
  castIngestedAt DateTime?
  /// Making-of, behind-the-scenes, featurettes, etc. Excluded from rating flow and stats.
  isFeaturette   Boolean       @default(false)
  /// TMDB poster URL (w342), populated during ingestion and backfill.
  posterUrl      String?
  /// TMDB vote_average (0–10). Restored for SEO seeded aggregates; not a community score.
  tmdbRating     Float?
  /// TMDB vote_count. Prefer seeding only when this is above a quality threshold.
  tmdbVoteCount  Int?
  /// When tmdbRating / tmdbVoteCount were last fetched from TMDB.
  tmdbDataFetchedAt DateTime?
  /// Theatrical / primary TMDB release date (date-only). Used to gate rating until release day.
  releaseDate    DateTime?     @db.Date
  /// SEO indexing rollout cohort (0 = not in a gated cohort; 1 = cohort-1, etc.).
  indexingCohort Int           @default(0)
  performances   Performance[]
  ratings        Rating[]
  forumThreads   ForumThread[]
  editorials     PerformanceEditorial[]

  @@unique([title, year])
  @@index([title])
  @@index([slug])
  @@index([indexingCohort])
}

/// Unique AI/human editorial copy for a performance rate page (actor+movie).
model PerformanceEditorial {
  id             String          @id @default(cuid())
  actorId        String
  movieId        String
  status         EditorialStatus @default(DRAFT)
  overview       String          @db.Text
  scoreAnalysis  String          @db.Text
  communityTake  String          @db.Text
  notableMoments String          @db.Text
  spoilerFree    Boolean         @default(true)
  wordCount      Int             @default(0)
  inputHash      String
  promptVersion  String
  model          String?
  generatedAt    DateTime?
  publishedAt    DateTime?
  editedAt       DateTime?
  editedByEmail  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actor          Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  movie          Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([actorId, movieId])
  @@index([status, publishedAt])
  @@index([status, updatedAt])
}

model Performance {
  id                     String          @id @default(cuid())
  userId                 String?
  actorId                String
  movieId                String
  emotionalRangeDepth    Int             @db.SmallInt
  characterBelievability Int             @db.SmallInt
  technicalSkill         Int             @db.SmallInt
  screenPresence         Int             @db.SmallInt
  chemistryInteraction   Int             @db.SmallInt
  comment                String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  character              String?
  /// 0-based billing order in the movie's cast (from TMDB credits order).
  order                  Int?
  /// Computed from order + cast size: ensemble films surface more leads/supporting.
  tier                   PerformanceTier @default(MINOR)
  /// TMDB movie vote_average copied onto the performance for SEO display only.
  /// Never merge with community Rating aggregates — keep labeled separately in UI.
  seededAggregateScore   Float?
  actor                  Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  movie                  Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user                   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId, movieId])
  @@index([actorId])
  @@index([movieId])
  @@index([actorId, movieId])
  @@index([tier])
  @@index([seededAggregateScore])
}

model Rating {
  id                     String      @id
  userId                 String?
  /// Signed-cookie anonymous identity for guest ratings (nullable when userId is set).
  /// Unique with actorId+movieId matches rate pages (/rate/{movie}/{actor}) — Rating has no performanceId.
  anonId                 String?
  actorId                String
  movieId                String
  emotionalRangeDepth    Int         @db.SmallInt
  characterBelievability Int         @db.SmallInt
  technicalSkill         Int         @db.SmallInt
  screenPresence         Int         @db.SmallInt
  chemistryInteraction   Int         @db.SmallInt
  weightedScore          Float       @default(0)
  comment                String?
  /// User marked their micro-review as containing spoilers.
  isSpoiler              Boolean     @default(false)
  /// Soft-hide comment after moderation; score remains.
  commentHidden          Boolean     @default(false)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  slug                   String?     @unique
  shareScore             Int?        @db.SmallInt
  roleName               String?
  breakdown              Json?
  actor                  Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  movie                  Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user                   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareImage             ShareImage?
  shortLinks             ShortLink[]
  commentReports         RatingCommentReport[]

  @@unique([userId, actorId, movieId])
  @@unique([anonId, actorId, movieId])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
  @@index([actorId])
  @@index([movieId])
  @@index([actorId, movieId])
  @@index([actorId, movieId, commentHidden, createdAt])
}

model RatingCommentReport {
  id                 String                   @id @default(cuid())
  ratingId           String
  reporterUserId     String
  reason             String                   @db.VarChar(40)
  details            String?
  status             RatingCommentReportStatus @default(OPEN)
  createdAt          DateTime                 @default(now())
  resolvedAt         DateTime?
  resolvedByUserId   String?
  rating             Rating                   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reporter           User                     @relation("CommentReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy         User?                    @relation("CommentReportResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([ratingId, reporterUserId])
  @@index([status, createdAt])
  @@index([ratingId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0)
  threads     ForumThread[]
  createdAt   DateTime      @default(now())
}

model ForumThread {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Optional links back into catalog entities
  actorId     String?
  movieId     String?
  actor       Actor?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  movie       Movie?        @relation(fields: [movieId], references: [id], onDelete: SetNull)
  isLocked    Boolean       @default(false)
  isPinned    Boolean       @default(false)
  posts       ForumPost[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, updatedAt])
  @@index([actorId])
  @@index([movieId])
  @@index([isPinned, updatedAt])
}

model ForumPost {
  id          String            @id @default(cuid())
  threadId    String
  thread      ForumThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  isSpoiler   Boolean           @default(false)
  isHidden    Boolean           @default(false)
  /// First post of a thread is the OP body
  isOriginal  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  reports     ForumPostReport[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

model ForumPostReport {
  id               String                   @id @default(cuid())
  postId           String
  reporterUserId   String
  reason           String                   @db.VarChar(40)
  details          String?
  status           RatingCommentReportStatus @default(OPEN)
  createdAt        DateTime                 @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  post             ForumPost                @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter         User                     @relation("ForumPostReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?                    @relation("ForumPostReportResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterUserId])
  @@index([status, createdAt])
  @@index([postId])
}

/// Public waitlist for visitors without an invite code.
model WaitlistEntry {
  id                      String    @id @default(cuid())
  email                   String    @unique
  createdAt               DateTime  @default(now())
  source                  String?   @db.VarChar(50)
  /// When the CINEMA2026 (beta invite) email should be sent. Null = never / legacy.
  inviteEmailScheduledFor DateTime?
  /// Set when the delayed beta invite email was successfully sent.
  inviteEmailSentAt       DateTime?

  @@index([createdAt])
  @@index([inviteEmailScheduledFor, inviteEmailSentAt])
}

/// Invite codes gate new account creation when INVITE_GATE_ENABLED=1.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  ownerId   String
  owner     User      @relation("OwnedInvites", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Cap on how many times this code can be redeemed. Default 1 = classic single-use invite.
  /// 0 = unlimited redemptions.
  maxUses   Int       @default(1)
  /// How many times this code has been successfully redeemed.
  usedCount Int       @default(0)
  /// Set only for single-use codes (maxUses = 1) after redemption. Multi-use uses InviteRedemption.
  usedById  String?   @unique
  usedBy    User?     @relation("UsedInvite", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  redemptions InviteRedemption[]

  @@index([ownerId])
  @@index([usedAt])
}

/// Tracks who redeemed an invite (needed for multi-use codes). One redemption per user globally.
model InviteRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([inviteCodeId])
}

model ShareImage {
  id        String   @id @default(cuid())
  ratingId  String   @unique
  feedUrl   String
  storyUrl  String
  ogUrl     String
  createdAt DateTime @default(now())
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
}

model ShortLink {
  code       String       @id
  targetUrl  String
  ratingId   String?
  createdAt  DateTime     @default(now())
  clickCount Int          @default(0)
  clicks     ShareClick[]
  rating     Rating?      @relation(fields: [ratingId], references: [id])

  @@index([ratingId])
}

model ShareClick {
  id          String    @id @default(cuid())
  shortLinkId String
  referer     String?
  userAgent   String?
  ipHash      String?
  createdAt   DateTime  @default(now())
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [code], onDelete: Cascade)

  @@index([shortLinkId])
}

model ServerEvent {
  id        String   @id @default(cuid())
  type      String
  ratingId  String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([ratingId])
}

model actors {
  id             Int            @id @default(autoincrement())
  tmdb_id        Int            @unique
  name           String         @db.VarChar(255)
  slug           String         @unique @db.VarChar(255)
  popularity     Decimal?       @db.Decimal(8, 3)
  biography      String?
  birthday       DateTime?      @db.Date
  place_of_birth String?        @db.VarChar(255)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  performances   performances[]
}

model performances {
  id                Int       @id @default(autoincrement())
  actor_id          Int?
  movie_title       String    @db.VarChar(255)
  character_name    String?   @db.VarChar(255)
  director_name     String?   @db.VarChar(255)
  release_date      DateTime? @db.Date
  release_year      Int?
  tmdb_movie_id     Int?
  movie_genre_names String?   @db.VarChar(500)
  movie_runtime     Int?
  movie_rating      String?   @db.VarChar(10)
  movie_overview    String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  actors            actors?   @relation(fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ratings           ratings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  id              Int           @id @default(autoincrement())
  user_id         String        @db.Uuid
  performance_id  Int?
  emotional_range Int?
  believability   Int?
  technical_skill Int?
  screen_presence Int?
  chemistry       Int?
  overall_score   Decimal?      @db.Decimal(4, 2)
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at      DateTime?     @default(now()) @db.Timestamp(6)
  performances    performances? @relation(fields: [performance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, performance_id])
}

/// Tier for a performance based on billing order and cast size (ensemble vs non-ensemble).
/// Used to decide which actors are surfaced, indexable, and eligible for CTAs.
enum PerformanceTier {
  LEAD
  SUPPORTING
  MINOR
}

enum UserStatus {
  NEW
  ONBOARDING
  ACTIVE
}

/// Bot slice for PageView: disclosed crawler UA vs unidentified/spoofed.
enum BotCategory {
  KNOWN_CRAWLER
  UNIDENTIFIED
}

enum RatingCommentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EditorialStatus {
  DRAFT
  PUBLISHED
  HUMAN_LOCKED
  NEEDS_REGEN
}

enum SiteEditorialKind {
  story
  news
}

enum SiteEditorialStatus {
  DRAFT
  PUBLISHED
}

/// Site journal articles (/stories, /news) published at runtime (daily cron / admin).
/// Merged with markdown under content/stories and content/news at read time.
model SiteEditorial {
  id           String              @id @default(cuid())
  kind         SiteEditorialKind
  slug         String              @unique
  title        String
  description  String              @db.Text
  bodyMarkdown String              @db.Text
  publishedAt  DateTime
  coverImage   String?
  /// JSON array of { actorSlug, movieSlug }
  related      Json?
  status       SiteEditorialStatus @default(PUBLISHED)
  source       String              @default("cron")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([kind, status, publishedAt])
  @@index([status, publishedAt])
}

// ─── ARIE (ActorRating Intelligence Engine) — Sprint 1 ───────────────────────

enum AriePlatform {
  X
}

enum ArieEventDecision {
  PENDING
  IGNORE
  PROCESS
  ERROR
}

enum ArieUsageProvider {
  X
  GROQ
  IMAGE
  OTHER
}

/// Idempotent inbound social/event stream (tweet, mention, tracked account, etc.).
model ArieInboundEvent {
  id               String            @id @default(cuid())
  platform         AriePlatform      @default(X)
  externalId       String
  authorHandle     String?
  authorId         String?
  text             String            @db.Text
  payload          Json
  receivedAt       DateTime          @default(now())
  decision         ArieEventDecision @default(PENDING)
  opportunityScore Int?
  scoreBreakdown   Json?
  reasonCodes      String[]          @default([])
  processedAt      DateTime?
  errorMessage     String?
  /// When the source post was published (X created_at) — distinct from receivedAt.
  sourceCreatedAt  DateTime?
  /// account_timeline | keyword_search | manual | admin_queue | validation
  discoveryMethod  String?
  discoveryRunId   String?
  discoveryCandidateId String?

  opportunities ArieOpportunity[]
  discoveryCandidate ArieDiscoveryCandidate? @relation(fields: [discoveryCandidateId], references: [id], onDelete: SetNull)

  @@unique([platform, externalId])
  @@index([receivedAt])
  @@index([decision, receivedAt])
  @@index([opportunityScore])
  @@index([discoveryRunId])
  @@index([discoveryMethod])
}

/// Scored content opportunity derived from an inbound event (or calendar seed).
/// contentType: "reply" (Sprint 2) | "original" (Original Content Engine).
model ArieOpportunity {
  id               String   @id @default(cuid())
  inboundEventId   String?
  /// reply | original
  contentType      String   @default("reply")
  format           String?
  status           String   @default("open")
  opportunityScore Int?
  scoreBreakdown   Json?
  priorityAuthor   Boolean  @default(false)

  /// Original Content Opportunity Score (0–100) — separate from reply Opportunity Score.
  originalScore          Int?
  originalScoreBreakdown Json?
  /// Cluster key so Deadline + Variety reporting the same casting = one opportunity.
  dedupeKey              String?
  expiresAt              DateTime?
  /// NEW | SCORED | ELIGIBLE | CONCEPTS_GENERATED | CONCEPT_SELECTED | DRAFT_GENERATED |
  /// QA_PASSED | QA_FAILED | READY | APPROVED | PUBLISHED | IGNORED | EXPIRED | REJECTED | FAILED | DUPLICATE
  originalStatus         String?
  concepts               Json?
  selectedConceptId      String?
  selectedConcept        Json?
  conceptRankMeta        Json?
  visualSpec             Json?
  finalDraft             String?            @db.Text
  draftJson              Json?
  qaResult               Json?
  publishStatus          AriePublishStatus  @default(DRAFT)
  publishMode            AriePublishMode?
  publishedTweetId       String?
  publishedAt            DateTime?
  publishError           String?
  approvedAt             DateTime?
  approvedByEmail        String?
  ignoredReason          String?
  /// { concept?, writer?, qa? }
  promptVersions         Json?
  /// Generation metadata (models, tokens, latency per stage)
  modelMeta              Json?
  conceptGenCount        Int                @default(0)
  draftGenCount          Int                @default(0)
  qaRunCount             Int                @default(0)

  /// Taxonomy: comparison | ranking | data_radar | question_debate | observation_analysis
  contentFormat          String?
  /// Source event attribution (distribution signal, not prestige ranking).
  sourceHandle           String?
  sourcePostId           String?
  sourceType             String?
  sourceUrl              String?
  sourceTimestamp        DateTime?
  /// Heuristic prediction snapshot — frozen once published (never overwrite with hindsight).
  prediction             Json?
  predictionVersion      String?
  predictionLockedAt     DateTime?
  predictedScore         Int?
  predictedTier          String?
  /// Immutable published copy + hash for idempotent/dedupe checks.
  publishedText          String?            @db.Text
  contentHash            String?
  /// Stable utm_content / first-party attribution key (defaults to opportunity id).
  attributionCode        String?
  /// Lineage snapshot at approve/publish (ids + prompt versions).
  lineage                Json?
  /// Soft lock for publish idempotency (PUBLISHING state + lease).
  publishLockUntil       DateTime?
  publishAttemptId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inboundEvent   ArieInboundEvent?   @relation(fields: [inboundEventId], references: [id], onDelete: SetNull)
  contextPackage ArieContextPackage?
  socialPosts    ArieSocialPost[]

  @@index([status, createdAt])
  @@index([inboundEventId])
  @@index([contentType, originalStatus, createdAt])
  @@index([dedupeKey])
  @@index([expiresAt])
  @@index([originalScore])
  @@index([publishStatus, createdAt])
  @@index([contentFormat])
  @@index([sourceHandle])
  @@index([contentHash])
  @@index([attributionCode])
  @@unique([publishAttemptId])
}

/// Persisted Context Package snapshot (Sprint 2) — agents consume this, not raw DB.
model ArieContextPackage {
  id             String   @id @default(cuid())
  opportunityId  String?  @unique
  inboundEventId String?
  package        Json
  builderVersion String
  createdAt      DateTime @default(now())

  opportunity ArieOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([inboundEventId])
  @@index([createdAt])
}

/// Metered spend for Cost Governor (Groq / X / images).
model ArieUsageRecord {
  id               String           @id @default(cuid())
  provider         ArieUsageProvider
  operation        String
  units            Float            @default(0)
  estimatedCostUsd Decimal          @db.Decimal(12, 6)
  metadata         Json?
  occurredAt       DateTime         @default(now())
  periodKey        String

  @@index([periodKey, provider])
  @@index([occurredAt])
}

/// Runtime pins (active prompt versions, kill switches mirrored, experiment flags).
model ArieConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Structured application log for ARIE pipelines (queryable ops).
model ArieLog {
  id        String   @id @default(cuid())
  level     String
  scope     String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@index([level, createdAt])
}

/// A/B (or multi-arm) experiment definition — runtime in Sprint 6.
model ArieExperiment {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("draft")
  hypothesis  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  arms        ArieExperimentArm[]
  assignments ArieExperimentAssignment[]
}

model ArieExperimentArm {
  id           String @id @default(cuid())
  experimentId String
  name         String
  promptRef    String
  weight       Int    @default(1)

  experiment  ArieExperiment            @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments ArieExperimentAssignment[]

  @@index([experimentId])
}

model ArieExperimentAssignment {
  id            String   @id @default(cuid())
  experimentId  String
  armId         String
  opportunityId String
  createdAt     DateTime @default(now())

  experiment ArieExperiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  arm        ArieExperimentArm @relation(fields: [armId], references: [id], onDelete: Cascade)

  @@unique([experimentId, opportunityId])
  @@index([armId])
}

enum ArieHumanGrade {
  A
  B
  C
  D
}

enum AriePublishStatus {
  DRAFT
  PUBLISHED
  FAILED
  SKIPPED
}

enum AriePublishMode {
  MANUAL
  AUTO
}

/// Sprint 2+ human eval loop — labeled drafts become the training goldset.
model AriePreviewEval {
  id                 String            @id @default(cuid())
  inboundEventId     String?
  sourceText         String            @db.Text
  authorHandle       String?
  /// Source tweet id when known (for live reply).
  inReplyToTweetId   String?
  opportunityScore   Int
  coveragePercent    Int
  coverage           Json
  contextPackage     Json
  draftText          String            @db.Text
  draftJson          Json?
  confidence         Int?
  promptVersion      String
  model              String
  generationMs       Int?
  promptTokens       Int?
  completionTokens   Int?
  humanGrade         ArieHumanGrade?
  /// 1–5: Did the draft address the tweet?
  scoreRelevance     Int?
  /// 1–5: Did ActorRating add something unique?
  scoreInsight       Int?
  /// 1–5: Were the facts correct?
  scoreAccuracy      Int?
  /// 1–5: Did it sound like ActorRating?
  scoreBrandVoice    Int?
  notes              String?           @db.Text
  gradedAt           DateTime?
  gradedByEmail      String?
  publishStatus      AriePublishStatus @default(DRAFT)
  publishMode        AriePublishMode?
  publishedTweetId   String?
  publishedAt        DateTime?
  publishError       String?
  createdAt          DateTime          @default(now())

  socialPosts ArieSocialPost[]

  @@index([humanGrade, createdAt])
  @@index([createdAt])
  @@index([opportunityScore])
  @@index([coveragePercent])
  @@index([promptVersion])
  @@index([publishStatus, createdAt])
  @@index([inReplyToTweetId])
}

/// Published (or attempted) X posts owned by the Publisher choke point.
model ArieSocialPost {
  id               String           @id @default(cuid())
  previewEvalId    String?
  opportunityId    String?
  platform         AriePlatform     @default(X)
  externalPostId   String?
  inReplyToTweetId String?
  text             String           @db.Text
  mode             AriePublishMode
  status           AriePublishStatus
  errorMessage     String?
  createdAt        DateTime         @default(now())

  /// Measurement + attribution (originals; nullable for replies).
  contentFormat       String?
  attributionCode     String?
  predictedScore      Int?
  predictionVersion   String?
  /// Native X metrics (nullable until fetched).
  impressions         Int?
  likes               Int?
  replies             Int?
  reposts             Int?
  quotes              Int?
  bookmarks           Int?
  profileVisits       Int?
  followerDelta       Int?
  linkClicks          Int?
  engagementRate      Float?
  /// ActorRating first-party metrics.
  actorRatingClicks   Int?
  actorRatingSessions Int?
  ratingsCreated      Int?
  waitlistSignups     Int?
  metricsUpdatedAt    DateTime?

  previewEval     AriePreviewEval?     @relation(fields: [previewEvalId], references: [id], onDelete: SetNull)
  opportunity     ArieOpportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  metricSnapshots ArieMetricSnapshot[]

  @@unique([platform, externalPostId])
  @@index([previewEvalId])
  @@index([opportunityId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([attributionCode])
}

/// Time-window metric trajectory for learning (1h / 6h / 24h / 72h / 7d).
model ArieMetricSnapshot {
  id                  String   @id @default(cuid())
  socialPostId        String
  /// 1h | 6h | 24h | 72h | 7d
  window              String
  capturedAt          DateTime @default(now())
  impressions         Int?
  likes               Int?
  replies             Int?
  reposts             Int?
  quotes              Int?
  bookmarks           Int?
  profileVisits       Int?
  followerDelta       Int?
  linkClicks          Int?
  actorRatingClicks   Int?
  actorRatingSessions Int?
  ratingsCreated      Int?
  waitlistSignups     Int?

  socialPost ArieSocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, window])
  @@index([capturedAt])
  @@index([window, capturedAt])
}

/// Immutable/versioned originals validation batch (scientific evaluation — not production publishing).
/// Re-running the same corpus always creates a NEW batch so ARIE versions remain comparable.
model ArieValidationBatch {
  id                 String    @id @default(cuid())
  name               String
  /// e.g. originals-v1 | originals-v1+upload:sha8 | upload:sha8
  corpusVersion      String
  /// Frozen input posts at create time (never mutated after create).
  corpusSnapshot     Json
  /// Frozen ARIE/prompt/builder versions captured at run start.
  arieVersions       Json?
  /// Source handle histogram at create time.
  sourceDistribution Json?
  /// CREATED | RUNNING | SAMPLED | GRADING | COMPLETE | FAILED
  status             String    @default("CREATED")
  /// score_only | full_pipeline
  runMode            String    @default("score_only")
  sampleConfig       Json?
  aggregateMetrics   Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdByEmail     String?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cases ArieValidationCase[]

  @@index([status, createdAt])
  @@index([corpusVersion, createdAt])
}

/// One source post inside a validation batch + frozen pipeline result + optional human grade.
model ArieValidationCase {
  id                String    @id @default(cuid())
  batchId           String
  /// Stable id within corpusSnapshot
  corpusItemId      String
  sourceHandle      String?
  sourceText        String    @db.Text
  sourceUrl         String?
  sourcePostId      String?
  /// seed_fixture | uploaded
  inputOrigin       String
  tags              String[]  @default([])
  opportunityId     String?
  /// Frozen pipeline snapshot (score, evidence, draft, QA…) — write-once after run.
  pipelineResult    Json?
  sampleReasons     String[]  @default([])
  selectedForReview Boolean   @default(false)
  reviewPriority    Int       @default(0)
  /// pending | ingested | pipeline_done | pipeline_error | graded
  status            String    @default("pending")
  errorMessage      String?
  humanGrade        ArieHumanGrade?
  /// 1–5 factual integrity / attribution correctness
  scoreTruthfulness Int?
  /// 1–5 discussion + ActorRating usefulness under uncertainty
  scoreUsefulness   Int?
  /// 1–5 framing (verified vs reported vs discussion)
  scoreFraming      Int?
  /// 1–5 brand voice
  scoreBrandVoice   Int?
  /// 1–5 would someone care right now (Creator Unlock)
  scoreTimely       Int?
  /// 1–5 uniquely ActorRating vs generic news account
  scoreNative       Int?
  /// 1–5 would a person stop and reply
  scoreInteresting  Int?
  gradeNotes        String?   @db.Text
  gradedAt          DateTime?
  gradedByEmail     String?
  /// LLM / machine eval — never overwrites humanGrade. Safe to re-run.
  machineEval       Json?
  machineGradedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch ArieValidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, corpusItemId])
  @@index([batchId, selectedForReview])
  @@index([batchId, humanGrade])
  @@index([batchId, status])
  @@index([opportunityId])
  @@index([sourceHandle])
}

/// Configurable discovery source (X account or keyword query). Not hardcoded in business logic.
model ArieDiscoverySource {
  id                   String    @id @default(cuid())
  provider             String    @default("X")
  /// account | keyword
  sourceType           String
  /// Stable key: account:handle or keyword:query
  sourceKey            String
  /// Account handle (no @) when sourceType=account
  handle               String?
  /// Search query when sourceType=keyword
  query                String?
  enabled              Boolean   @default(true)
  /// Higher = polled first within run budget
  priority             Int       @default(50)
  topicTags            String[]  @default([])
  pollIntervalMinutes  Int       @default(15)
  maxCandidatesPerPoll Int       @default(10)
  /// Cached X user id for account sources
  authorId             String?
  lastPolledAt         DateTime?
  lastSeenPostId       String?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  candidates ArieDiscoveryCandidate[]

  @@unique([provider, sourceKey])
  @@index([enabled, priority])
  @@index([provider, sourceType])
}

/// One discovery job execution (observable, idempotent runs).
model ArieDiscoveryRun {
  id                   String    @id @default(cuid())
  provider             String    @default("X")
  /// RUNNING | SUCCESS | PARTIAL | RATE_LIMITED | ERROR | NO_RESULTS | DISABLED
  status               String    @default("RUNNING")
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  candidatesFound      Int       @default(0)
  candidatesDeduped    Int       @default(0)
  candidatesIngested   Int       @default(0)
  candidatesRetried    Int       @default(0)
  scoutExcluded        Int       @default(0)
  /// Legacy alias mirrored from scoutExcluded for older dashboards.
  scoutIgnored         Int       @default(0)
  opportunityEligible  Int       @default(0)
  opportunitiesCreated Int       @default(0)
  opportunityDeduped   Int       @default(0)
  inboundCreated       Int       @default(0)
  inboundDeduped       Int       @default(0)
  errors               Json?
  rateLimitInfo        Json?
  capabilitySnapshot   Json?
  triggeredBy          String?

  candidatesFirst  ArieDiscoveryCandidate[] @relation("CandidateFirstRun")
  candidatesLast   ArieDiscoveryCandidate[] @relation("CandidateLastRun")

  @@index([provider, startedAt])
  @@index([status, startedAt])
}

/// A post discovered before/during ingest — full lineage to inbound event + opportunity.
model ArieDiscoveryCandidate {
  id                 String    @id @default(cuid())
  provider           String    @default("X")
  externalPostId     String
  authorHandle       String?
  authorId           String?
  text               String    @db.Text
  sourceUrl          String?
  sourcePublishedAt  DateTime?
  /// First time this post was discovered.
  discoveredAt       DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  /// account_timeline | keyword_search
  discoveryMethod    String
  /// First discovery run that created this candidate.
  discoveryRunId     String
  lastDiscoveryRunId String?
  discoverySourceId  String?
  discoveryPriority  Int       @default(0)
  /// unknown | stale | active | accelerating — never fabricated without history
  velocityStatus     String    @default("unknown")
  publicMetrics      Json?
  /// PENDING | INGESTING | INGESTED | ERROR
  ingestStatus       String    @default("PENDING")
  ingestStartedAt    DateTime?
  ingestAttemptCount Int       @default(0)
  ingestLeaseUntil   DateTime?
  lastIngestError    String?
  /// new | rediscovered | ingested
  dedupeState        String    @default("new")
  inboundEventId     String?
  opportunityId      String?
  /// pending | scout_excluded | score_ineligible | eligible | duplicate | error
  scoutStatus        String    @default("pending")
  originalScore      Int?
  errorMessage       String?

  firstRun      ArieDiscoveryRun      @relation("CandidateFirstRun", fields: [discoveryRunId], references: [id], onDelete: Cascade)
  lastRun       ArieDiscoveryRun?     @relation("CandidateLastRun", fields: [lastDiscoveryRunId], references: [id], onDelete: SetNull)
  source        ArieDiscoverySource?  @relation(fields: [discoverySourceId], references: [id], onDelete: SetNull)
  inboundEvents ArieInboundEvent[]

  @@unique([provider, externalPostId])
  @@index([discoveryRunId])
  @@index([lastDiscoveryRunId])
  @@index([discoverySourceId])
  @@index([discoveredAt])
  @@index([lastSeenAt])
  @@index([dedupeState])
  @@index([ingestStatus])
  @@index([scoutStatus])
  @@index([discoveryPriority])
}
