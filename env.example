# Production Environment Variables
# Copy this to .env.local and fill in your values

# Base URL for production (used for OAuth redirects)
NEXT_PUBLIC_BASE_URL=https://actorrating.com

# Note: In Supabase Dashboard > Authentication > Settings:
# - Set Site URL to: https://actorrating.com
# - Add redirect URL: https://actorrating.com/auth/callback
# - Ensure Google OAuth provider is configured with the same redirect URL

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/actorrating

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Note: In Supabase Dashboard > Authentication > Settings:
# - Disable "Enable email confirmations" for immediate sign-in
# - Set Site URL to: https://actorrating.com
# - Add redirect URL: https://actorrating.com/auth/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/actorrating_shadow?schema=public
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=
SHORT_URL_DOMAIN=
REDIS_URL=
USE_PUPPETEER=false
TMDB_API_KEY=

# Formspree Configuration for Feedback Form
NEXT_PUBLIC_FORMSPREE_FORM_ID=YOUR_FORMSPREE_FORM_ID

# Google Analytics (optional - only loads if analytics cookies are consented)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
