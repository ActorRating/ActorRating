# Production Environment Variables
# Copy this to .env.local and fill in your values

# Base URL for production
NEXT_PUBLIC_BASE_URL=https://actorrating.com

# Database (local: direct URL; production: use pooler URL with ?pgbouncer=true to avoid prepared-statement errors in serverless)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/actorrating

# NextAuth (Auth.js) — required in production
NEXTAUTH_URL=https://actorrating.com
NEXTAUTH_SECRET=generate_a_long_random_string
# Alias supported by Auth.js v5:
# AUTH_SECRET=
# AUTH_URL=

# Magic link email auth (required in production)
# SMTP URL format:
# EMAIL_SERVER=smtp://username:password@smtp.your-provider.com:587
EMAIL_SERVER=
EMAIL_FROM="ActorRating <noreply@actorrating.com>"
# Optional aliases used by auth.ts:
# AUTH_EMAIL_SERVER=
# AUTH_EMAIL_FROM=

# Optional Google OAuth (set all 3 to enable Google sign-in button + provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_AVAILABLE=0

SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/actorrating_shadow?schema=public
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=
SHORT_URL_DOMAIN=
REDIS_URL=
USE_PUPPETEER=false
TMDB_API_KEY=

# Formspree Configuration for Feedback Form
NEXT_PUBLIC_FORMSPREE_FORM_ID=YOUR_FORMSPREE_FORM_ID

# Google Analytics (optional - only loads if analytics cookies are consented)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Usermaven
NEXT_PUBLIC_USERMAVEN_KEY=UMZeHyLWV7
