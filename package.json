{
  "name": "actor-rating",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npx tsx scripts/generate-sitemaps.ts && prisma generate && next build",
    "db:deploy": "prisma migrate deploy",
    "build:deploy": "npm run db:deploy && npm run build",
    "check:runtime-env": "node -r dotenv/config scripts/validate-runtime-env.js",
    "prestart": "npm run check:runtime-env",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev --name init",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "demo:seed": "tsx scripts/demo-seed-share.ts",
    "demo:cleanup": "tsx scripts/cleanup-demo-data.ts",
    "export:data": "tsx scripts/export-data.ts",
    "import:data": "tsx scripts/import-data.ts",
    "export:summary": "tsx scripts/view-export-summary.ts",
    "perf:lighthouse": "lighthouse-ci http://localhost:3000 --config=.lighthouserc.json || true",
    "backfill:tmdb": "tsx scripts/backfill-characters-from-tmdb.ts",
    "backfill:tmdb:goodfellas": "tsx scripts/backfill-characters-from-tmdb.ts --movie=Goodfellas --year=1990",
    "ingest:all-cast": "tsx scripts/ingest-all-movies-cast.ts",
    "health:cast-ingestion": "tsx scripts/health-cast-ingestion.ts",
    "postinstall": "prisma generate",
    "remove-adult-content": "tsx scripts/remove-adult-content.ts",
    "remove-adult-content:yes": "tsx scripts/remove-adult-content.ts --yes",
    "list-subtle-adult-movies": "tsx scripts/list-subtle-adult-movies.ts",
    "remove-adult-performers": "tsx scripts/remove-adult-performers.ts",
    "remove-adult-performers:yes": "tsx scripts/remove-adult-performers.ts --yes",
    "generate:sitemaps": "tsx scripts/generate-sitemaps.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.744.0",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.1",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.6.4",
    "@vercel/speed-insights": "^1.3.1",
    "algoliasearch": "^5.35.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "bad-words": "^4.0.0",
    "base64-js": "^1.5.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.535.0",
    "nanoid": "^5.1.6",
    "next": "^15.4.8",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-instantsearch": "^7.16.2",
    "resend": "^4.0.0",
    "server-only": "^0.0.1",
    "swr": "^2.3.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.14.0",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.4.4",
    "jest": "^29.7.0",
    "prisma": "^6.13.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
